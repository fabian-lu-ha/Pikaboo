{
  "name": "brand-autopilot-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Remotion project that renders marketing videos from a JSON storyboard. Invoked by the FastAPI backend via subprocess.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MarketingVideo out.mp4",
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.395",
    "@remotion/cli": "4.0.395",
    "@remotion/renderer": "4.0.395",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.395"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
