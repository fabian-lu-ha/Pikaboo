# Brand Autopilot — environment template. Copy to backend/.env to use.

# local | supabase
DEPLOY_MODE=local

# SQLite for local mode; the Supabase Postgres URL when DEPLOY_MODE=supabase.
# DATABASE_URL=postgresql://postgres:<password>@<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./brand_autopilot.db

# Required when DEPLOY_MODE=supabase. Ignored locally.
SUPABASE_URL=
SUPABASE_KEY=

# LLM access. Vertex AI Express Mode (api-key auth, no project/location needed).
GEMINI_API_KEY=
# Override the default text + image model ids if needed (preview names change).
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_IMAGE_MODEL=nano-banana-pro-preview

# Peec MCP / API — get a key at https://app.peec.ai/api-keys after signup.
# (See docs/PEEC_MCP_INTEGRATION.md for the contest setup steps.)
PEEC_API_KEY=
# PEEC_PROJECT_ID=          # optional — pin to a specific Peec project
# PEEC_BASE_URL=https://api.peec.ai
# PEEC_MCP_URL=https://api.peec.ai/mcp

# Local-only filesystem storage path. Ignored when DEPLOY_MODE=supabase.
STORAGE_DIR=./storage

# HubSpot CRM — Private App access token, NOT a developer API key.
# Settings → Integrations → Private Apps → Create. Required scopes:
#   crm.objects.contacts.read, crm.objects.products.read, oauth
# (events.read is optional — used to pull email opens/clicks.)
# This is per-brand: enter the token in the "Connect CRM" modal on the
# audience page. Without HubSpot connected, the page falls back to the
# deterministic sample-data provider.
# HUBSPOT_DOCS=https://developers.hubspot.com/docs/api/private-apps

# Pioneer AI (Fastino Labs) — per-tenant Gemma fine-tuning.
# Get a key at https://labs.fastino.ai (free tier ships $75 credit, ~5 trainings).
# Without a key the orchestrator falls back to a 90-second simulator that
# emits the same events so the demo flow still works.
PIONEER_API_KEY=
# PIONEER_BASE_URL=https://api.fastino.com
# PIONEER_BASE_MODEL=gemma-3-4b-it
